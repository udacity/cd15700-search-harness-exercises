{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.2",
  "providers": {
    "openai": {
      "settings": {
        "apiKey": "{env:OPENAI_API_KEY}",
        "baseURL": "{env:OPENAI_BASE_URL}"
      }
    }
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "deny" }
  ],
  "default_agent": "docs-agent",
  "mcp": {
    "servers": {
      "rag": {
        "type": "local",
        "command": ["python3", "rag_server.py"],
        "codemode": false
      }
    }
  }
}
